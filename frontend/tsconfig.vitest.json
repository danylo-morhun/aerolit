{
  /* Tests run in Node, so they get Node's globals and the matcher types —
     neither of which belongs in the browser build's type environment. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["vite/client", "node", "vitest/globals", "@testing-library/jest-dom/vitest"],
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "noEmit": true
  },
  "include": ["src/**/*.spec.ts", "tests/**/*.ts", "e2e/**/*.ts", "src/**/*.ts", "src/**/*.vue"],
  "exclude": []
}
